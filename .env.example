# Required
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:5432/app_db

# Strongly recommended before exposing the dashboard beyond localhost
ADMIN_TOKEN=

# Optional providers (defaults work keyless but are rate-limited)
SOLANA_RPC_URL=            # Helius / QuickNode / Triton endpoint. Public RPC is used otherwise (429-prone).
RUGCHECK_API_KEY=          # optional, raises RugCheck limits
JUPITER_API_KEY=           # from portal.jup.ag — needed for real router quotes and any live execution
BIRDEYE_API_KEY=           # reserved, not used in v1

# Bot
BOT_AUTOSTART=true         # set false to run the scheduler only via POST /api/bot/start
LOG_LEVEL=INFO
SCAN_INTERVAL_SEC=         # overridden by dashboard settings

# LIVE TRADING — leave unset/false. See docs/LIVE_TRADING.md. Never paste a key you care about.
LIVE_TRADING_ENABLED=false
TRADING_WALLET_SECRET=     # base58 keypair or JSON byte array of a DEDICATED wallet. Never logged/displayed.
